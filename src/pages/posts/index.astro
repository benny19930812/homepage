---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const posts = (await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base title="文章 · 黃斌魁" description="黃斌魁的技術文章：金流、交易系統與後端架構。">
  <header class="page-head">
    <h1>文章</h1>
    <p>後端開發、金流與交易系統的實作筆記。</p>
  </header>
  {posts.length === 0 ? (
    <p class="empty">還沒有文章。</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`${base}posts/${post.id}/`}>
            <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            <div class="text">
              <h2>{post.data.draft ? '［草稿］' : ''}{post.data.title}</h2>
              <p>{post.data.description}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</Base>
